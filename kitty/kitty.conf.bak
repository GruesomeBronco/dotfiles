
# ~/.config/kitty/kitty.conf

# --- Шрифты ---
# font_family FiraCode Nerd Font  
font_size 14.0
# Fix for Docker Compose spinner freezing issue
# Maps the entire Braille Pattern range (U+2800 to U+28FF)
# The U+2834 character (⠴) falls within this range.
# symbol_map U+2800-U+28FF DejaVu Sans Mono


# bold_font auto
# italic_font auto

# --- Поведение окна ---
enable_audio_bell no
scrollback_lines 10000
detect_urls yes
background_opacity 1

# --- Цвета ---
# include ./light_theme.conf
# include ./ayu_theme.conf
# foreground #cdd6f4
# background #1e1e2e
# cursor     #f5c2e7

# color0  #1e1e2e0
# color1  #f38ba8
# color2  #a6e3a1
# color3  #f9e2af
# color4  #89b4fa
# color5  #f5c2e7
# color6  #94e2d5
# color7  #bac2de
# color8  #585b70
# color9  #f38ba8
# color10 #a6e3a1
# color11 #f9e2af
# color12 #89b4fa
# color13 #f5c2e7
# color14 #94e2d5
# color15 #a6adc8

# --- Горячие клавиши ---
# map ctrl+shift+c copy_to_clipboard
# map ctrl+shift+v paste_from_clipboard


# BEGIN_KITTY_FONTS
font_family      family="DejaVu Sans Mono"
bold_font        auto
italic_font      auto
bold_italic_font auto

# # 1. Block Elements (U+2580) - Used for progress bars
# symbol_map U+2580-U+259F DejaVu Sans Mono

# # 2. Geometric Shapes (U+25A0) - Common CLI symbols (the new map)
# symbol_map U+25A0-U+25FF DejaVu Sans Mono

# # 3. Braille Patterns (U+2800) - Used for spinners (the original suspect)
# symbol_map U+2800-U+28FF DejaVu Sans Mono

# # 4. Check Mark
# symbol_map U+2714 DejaVu Sans Mono

# END_KITTY_FONTS